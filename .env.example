# Twitch Integration (optional — game works without it)
# Create an app at https://dev.twitch.tv/console/apps
VITE_TWITCH_CLIENT_ID=your_client_id_here
VITE_TWITCH_CHANNEL=your_channel_name_here

# Paste your App Access Token below, OR inject it at runtime.
# See README.md §Twitch Setup for the curl command to generate it.
VITE_TWITCH_TOKEN=your_app_access_token_here
